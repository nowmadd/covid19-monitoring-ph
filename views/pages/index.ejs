<!DOCTYPE html>
<html>
<head>
  <% include ../partials/header.ejs %>
</head>

<body>

<div class="jumbotron text-center mb-0">
  <div class="container">
    <h1>PHILIPPINES COVID-19 TRACKER </h1>
     <div class="alert alert-light text-center" role="alert">
      As of <%= date %>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-12 col-md-4 p-1">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title text-center text-info">TOTAL CASES</h2>
            <p class="card-text ">
              <h2 class="text-center"><%= result.summary.total_cases %></h2>
              <p class="h6 text-center text-muted"> <% if (result.change.total_cases ==0 ) { %><i> waiting for update</i> <% } else { %>+ <%= result.change.total_cases %><% } %> </p>
            </p>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4 p-1">
            <div class="card">
              <div class="card-body">
                <h2 class="card-title text-center text-success">RECOVERIES</h2>
                <p class="card-text ">
                  <h2 class="text-center"><%= result.summary.recovered %></h2>
                  <p class="h6 text-center text-muted"><% if (result.change.total_cases ==0 ) { %><i> waiting for update</i> <% } else { %>+ <%= result.change.recovered %> <% } %></p>
                </p>
              </div>
            </div>
      </div>
      <div class="col-12 col-md-4 p-1">
        <!-- <h3 class="text-center text-danger">DEATHS</h3>
            <h4 class="text-center"><%= result.summary.deaths %></h4>
            <p class="text-center">+ <%= result.change.deaths %></p> -->
          <div class="card">
            <div class="card-body">
              <h2 class="card-title text-center text-danger">DEATHS</h2>
              <p class="card-text ">
                <h2 class="text-center"><%= result.summary.deaths %></h2>
                <p class="h6 text-center text-muted"><% if (result.change.total_cases ==0 ) { %> <i> waiting for update</i> <% } else { %> + <%= result.change.deaths %> <% } %></p>
              </p>
            </div>
          </div>
      </div>
    </div> 
    </div>
  
</div>

<p id="yy"style="display:none"><%= data %></p>
<div class="container" >
  <h2 class="text-center text-muted"> HISTORY GRAPH</h2>
   <!-- <span class="text-center">
 <p class="text-center" style="font-size: 10px;"><i>Results from the last <%= show %> days only</i></p></span> -->
  <div class="chartjs-size-monitor" style="position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; overflow: hidden; pointer-events: none; visibility: hidden; z-index: -1;"><div class="chartjs-size-monitor-expand" style="position:absolute;left:0;top:0;right:0;bottom:0;overflow:hidden;pointer-events:none;visibility:hidden;z-index:-1;"><div style="position:absolute;width:1000000px;height:1000000px;left:0;top:0"></div></div><div class="chartjs-size-monitor-shrink" style="position:absolute;left:0;top:0;right:0;bottom:0;overflow:hidden;pointer-events:none;visibility:hidden;z-index:-1;"><div style="position:absolute;width:300%;height:300%;left:0; top:0"></div></div></div>
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    
  </div>

  <canvas class="my-4 chartjs-render-monitor" id="myChart"></canvas>



 
</div>
<script>
  var ctx = document.getElementById('myChart').getContext('2d');
  var x= document.getElementById("yy").innerText
  var myChart = new Chart(ctx, {
      type: 'line',
      data: JSON.parse(x),
      options: {
          scales: {
              yAxes: [{
                  ticks: {
                      beginAtZero: true
                  }
              }]
          }
      }
  });
  </script>

</body>
</html>
