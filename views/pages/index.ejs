<div class="container">
  <div class="row">
    <div class="col-12 col-md-4">
      <h3 class="text-center text-info">TOTAL CASES</h3>
          <h4 class="text-center"><%= result.summary.total_cases %></h4>
          <p class="text-center">+ <%= result.change.total_cases %> today</p>
    </div>
    <div class="col-12 col-md-4">
      <h3 class="text-center text-success">RECOVERIES</h3>
          <h4 class="text-center"><%= result.summary.recovered %></h4>
          <p class="text-center">+ <%= result.change.recovered %> today</p>
    </div>
    <div class="col-12 col-md-4">
      <h3 class="text-center text-danger">DEATH</h3>
          <h4 class="text-center"><%= result.summary.deaths %></h4>
          <p class="text-center">+ <%= result.change.deaths %> today</p>
    </div>
  </div> 
