<!DOCTYPE html>
<html>
<head>
  <% include ../partials/header.ejs %>
</head>

<body>

<div class="jumbotron text-center mb-0">
  <div class="container">
    <h1>PHILIPPINES COVID-19 TRACKER </h1>
     <div class="alert alert-light text-center" role="alert">
      As of <%= date %>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-12 col-md-4 p-1">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title text-center text-info">TOTAL CASES</h2>
            <p class="card-text ">
              <h2 class="text-center"><%= result.summary.total_cases %></h2>
              <p class="h6 text-center text-muted">+ <%= result.change.total_cases %> </p>
            </p>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4 p-1">
            <div class="card">
              <div class="card-body">
                <h2 class="card-title text-center text-success">RECOVERIES</h2>
                <p class="card-text ">
                  <h2 class="text-center"><%= result.summary.recovered %></h2>
                  <p class="h6 text-center text-muted">+ <%= result.change.recovered %> </p>
                </p>
              </div>
            </div>
      </div>
      <div class="col-12 col-md-4 p-1">
        <!-- <h3 class="text-center text-danger">DEATHS</h3>
            <h4 class="text-center"><%= result.summary.deaths %></h4>
            <p class="text-center">+ <%= result.change.deaths %></p> -->
          <div class="card">
            <div class="card-body">
              <h2 class="card-title text-center text-danger">DEATHS</h2>
              <p class="card-text ">
                <h2 class="text-center"><%= result.summary.deaths %></h2>
                <p class="h6 text-center text-muted">+ <%= result.change.deaths %> </p>
              </p>
            </div>
          </div>
      </div>
    </div> 
    </div>
  
</div>
<div class="container">
  <h2 class="text-center text-muted"> HISTORY GRAPH</h2>
  <canvas id="myChart" width="400" height="150"></canvas>
  <p id="yy"style="display:none"><%= data %></p>
</div>
<script>
  var ctx = document.getElementById('myChart').getContext('2d');
  var x= document.getElementById("yy").innerText
  var myChart = new Chart(ctx, {
      type: 'line',
      data: JSON.parse(x),
      options: {
          layout: {
            padding: {
              bottom: 50
            }
          },
          scales: {
              yAxes: [{
                  ticks: {
                      beginAtZero: true
                  }
              }]
          }
      }
  });
  </script>

</body>
</html>
